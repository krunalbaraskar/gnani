# Copy to .env (dev: project root; installed app: %APPDATA%\Bolo\.env) and fill in.
# Keys are read only by the Electron main process and are never sent to the UI.

# --- Gnani speech-to-text (required for live transcription) ---
GNANI_API_KEY=
# Optional override of the streaming endpoint. Default: wss://api.vachana.ai/stt/v3/stream
# GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream

# --- Testing for free without a Gnani key (Groq: free key at console.groq.com) ---
# Uncomment these four and leave GNANI_API_KEY empty. See "Try it free" in the README.
# STT_PROVIDER=whisper
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_API_KEY=
# Thinking models (Gemini 2.5 Flash, Groq's gpt-oss) think before answering, which can take
# 20 s or more. "low" makes them answer in seconds; Gemini 2.5 Flash also accepts "none".
# Leave empty for models that don't think (gpt-4o-mini, Ollama): some reject the field.
# LLM_REASONING_EFFORT=lowgsk_...
# Optional: WHISPER_BASE_URL (default Groq), WHISPER_MODEL (default whisper-large-v3),
# WHISPER_API_KEY (default: LLM_API_KEY when both point at the same service).

# --- Suggestion LLM: any OpenAI-compatible /chat/completions endpoint ---
# Hosted example (OpenAI):        https://api.openai.com/v1
# Local Ollama:                   http://localhost:11434/v1   (key can be anything, e.g. "ollama")
# Evon / any model served by vLLM: http://<host>:8000/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# --- Calendar sign-in (optional; see "Connect your calendar" in the README) ---
# Google Calendar: an OAuth client of type "Desktop app" in Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Outlook / Microsoft 365: an app registration with redirect URI http://localhost
# ("Mobile and desktop applications") and delegated permission Calendars.Read.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_TENANT=common
