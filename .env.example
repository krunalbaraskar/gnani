# Copy to .env (dev: project root; installed app: %APPDATA%\Bolo\.env) and fill in.
# Keys are read only by the Electron main process and are never sent to the UI.

# --- Gnani speech-to-text (required for live transcription) ---
GNANI_API_KEY=
# Optional override of the streaming endpoint. Default: wss://api.vachana.ai/stt/v3/stream
# GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream

# --- Suggestion LLM: any OpenAI-compatible /chat/completions endpoint ---
# Hosted example (OpenAI):        https://api.openai.com/v1
# Local Ollama:                   http://localhost:11434/v1   (key can be anything, e.g. "ollama")
# Evon / any model served by vLLM: http://<host>:8000/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
